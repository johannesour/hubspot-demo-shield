{
  "manifest_version": 3,
  "name": "HubSpot Demo Shield",
  "version": "1.0.0",
  "description": "Anonymisiert personenbezogene Daten im HubSpot-Portal für Live-Demos – per Fake-Daten oder Unschärfe. Nur lokal im Browser.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HubSpot Demo Shield",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "toggle-shield": {
      "suggested_key": { "default": "Alt+Shift+A", "mac": "Alt+Shift+A" },
      "description": "Anonymisierung an/aus"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.hubspot.com/*",
        "https://app-eu1.hubspot.com/*",
        "https://app-na2.hubspot.com/*",
        "https://app-na3.hubspot.com/*",
        "https://app-ap1.hubspot.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "css": ["content/shield.css"],
      "js": [
        "shared/defaults.js",
        "content/selectors.js",
        "content/faker.js",
        "content/anonymizer.js",
        "content/picker.js",
        "content/main.js"
      ]
    }
  ]
}
